# Keep this file as a template. Copy to .env; never commit .env or production secrets.
# Flutter uses this public endpoint only; for a phone use the PC Wi-Fi IPv4 address.
API_BASE_URL=http://192.168.1.113:5000
ASPNETCORE_URLS=http://0.0.0.0:5000
ASPNETCORE_ENVIRONMENT=Development
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Cors__AllowedOrigins__0=

# JWT: generate a new 3072-bit RSA PKCS#8 private key and random peppers for each environment.
# Values are Base64-encoded binary. Leave blank only for ephemeral Development startup keys.
Jwt__SigningPrivateKeyPkcs8Base64=
Jwt__PreviousSigningPublicKeys__0=
Jwt__KeyId=current
Jwt__Issuer=FiremanApi
Jwt__Audience=FiremanClient
Jwt__AccessTokenMinutes=20
Jwt__RefreshTokenDays=30
Jwt__ClockSkewSeconds=5
Auth__RefreshTokenHashPepper=
Auth__GuestSecretHashPepper=

# Google Play / Google Sign-In. Public identifiers are not secrets; secrets stay server-side.
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=
GoogleAuth__AllowedAudiences__0=
GoogleAuth__AndroidPackageName=com.fireman.fireman_flutter
GoogleAuth__AndroidSha1=
ThirdParty__PlayIntegrityProjectNumber=
ThirdParty__PlayIntegrityServiceAccountJson=
ThirdParty__PlayDeveloperServiceAccountJson=

# Database. For Postgres, use separate application/read-only/migration credentials in deployed environments.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fireman_db;Username=fireman;Password=CHANGE_ME;Minimum Pool Size=1;Maximum Pool Size=50;Timeout=15;Command Timeout=30
ConnectionStrings__ReadOnly=
ConnectionStrings__Migration=
Database__PoolMinSize=1
Database__PoolMaxSize=50
Database__CommandTimeoutSeconds=30
Persistence__Provider=InMemory
Firebase__ProjectId=

# Redis. Use TLS and a unique password outside local development.
REDIS_PASSWORD=CHANGE_ME
ConnectionStrings__Redis=localhost:6379,password=CHANGE_ME,ssl=False
Redis__Tls=false
Redis__KeyPrefix=dev:
Redis__RoomLockSeconds=10
Redis__SessionTtlSeconds=3600
Redis__ReconnectTimeoutSeconds=20

# Optional message broker.
RabbitMQ__ConnectionString=
RabbitMQ__QueuePrefix=dev.
RabbitMQ__RetryCount=3

# Game/live-ops values; currently these are configuration entries to bind into options as services adopt them.
Game__PlayersPerRoom=4
Game__TickRate=30
Game__ReconnectSeconds=20
Game__MatchmakingTimeoutSeconds=30
Game__GuestCleanupDays=30
Game__MinimumClientVersion=1.0.0
Game__MaintenanceMode=false
Game__DrainNewRooms=false
RateLimiting__AuthRequestsPerMinute=10
RateLimiting__GeneralRequestsPerMinute=120
RateLimiting__GuestCreationsPerMinute=5
RateLimiting__RoomCreationsPerMinute=5
RateLimiting__MessagesPerMinute=30

# Optional observability, internal services and push/email.
Observability__SentryDsn=
Observability__SeqUrl=
Observability__SeqApiKey=
Observability__MetricsToken=
Observability__InstanceId=local
Observability__Region=local
DataProtection__KeysPath=
DataProtection__ApplicationName=Fireman
ThirdParty__FirebaseMessagingServiceAccountJson=
ThirdParty__EmailProviderApiKey=
ThirdParty__CloudflareApiToken=
ThirdParty__FeatureFlagUrl=
ThirdParty__FeatureFlagToken=
ThirdParty__InternalApiKey=

# Docker Compose local database. Keep in sync with ConnectionStrings__DefaultConnection.
POSTGRES_DB=fireman_db
POSTGRES_USER=fireman
POSTGRES_PASSWORD=CHANGE_ME
