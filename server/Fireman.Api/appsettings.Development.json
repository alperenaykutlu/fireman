{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Jwt": {
    "Issuer": "FiremanApi",
    "Audience": "FiremanClient",
    "KeyId": "development",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 5
  }
}
